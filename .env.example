# Copy to .env (never commit .env). Every variable the project reads.

# Shared secret for write endpoints (POST /v1/expenses, /v1/csv/import,
# /v1/categorise/feedback, /v1/categorise/retrain). Empty = writes disabled (fail closed, HTTP 503).
EXPENSE_API_KEY=

# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Paths; relative paths resolve against the repo root.
EXPENSES_DB_PATH=data/expenses.db
MODEL_PATH=models/categoriser.joblib
DATASET_PATH=data/ngn_expenses_labelled.csv

# Set to 1 to load the 600 SYNTHETIC demo expenses into an empty database. Off by default.
DEMO_DATA=

# In-process per-IP limits (behind a reverse proxy the client IP is the proxy; limit there too).
RATE_LIMIT_PER_MINUTE=60
FEEDBACK_RATE_LIMIT_PER_MINUTE=10
# Queued corrections that trigger a background retrain.
FEEDBACK_BATCH_SIZE=20

# Frontend (build time, public): API base URL.
VITE_API_BASE=http://localhost:8000
